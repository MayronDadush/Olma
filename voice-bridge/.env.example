# Copy to /opt/olma2-voice-bridge/.env on the box and fill in. NEVER commit the
# filled copy. The bridge also reads /opt/olma2/.env for DB, OpenRouter and
# Twilio credentials, so only the voice-specific keys belong here.

# --- speech in -------------------------------------------------------------
DEEPGRAM_API_KEY=            # Nova-3, Hebrew STT

# --- speech out ------------------------------------------------------------
VOICE_TTS=elevenlabs         # elevenlabs | cartesia
ELEVENLABS_API_KEY=
EL_VOICE_ID=                 # default EXAVITQu4vr4xnSDxMaL (Sarah)
CARTESIA_API_KEY=            # only needed when VOICE_TTS=cartesia
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3

# --- who may be called -----------------------------------------------------
# Comma-separated E.164. THIS IS THE ACCESS CONTROL for outbound calls —
# see the note in README.md about the hardcoded fallback in server.js.
VOICE_ENABLED_PHONES=

# --- misc ------------------------------------------------------------------
VOICE_SPOKEN_NAME=           # how Olma pronounces her own name
VOICE_MAX_CONCURRENT=2       # ceiling; two calls on a 1-vCPU box is optimistic
VOICE_TOUR=
