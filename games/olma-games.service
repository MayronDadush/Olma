[Unit]
Description=Olma game nights (gamesd, 127.0.0.1:8794)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/olma-games/bin/gamesd.js
WorkingDirectory=/opt/olma-games
# GAMES_DB_URL, GAMES_PORT, GAMES_PUBLIC_BASE. Written once by
# scripts/setup-box.sh, 0600, never synced by deploy.sh.
EnvironmentFile=/opt/olma-games/.env
Restart=on-failure
RestartSec=5
# The box is 2 GB and the gateway already swaps; a runaway here must not
# take Olma with it.
MemoryMax=192M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
